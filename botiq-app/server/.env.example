# ── Database (Postgres) ──
DATABASE_URL=postgres://botiq:botiq_dev@localhost:5433/botiq

# ── Provider: "meta" or "twilio" ──
WHATSAPP_PROVIDER=meta

# ── Meta WhatsApp Cloud API ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_PHONE=
META_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=propbot_verify_token

PORT=3002
PUBLIC_URL=http://localhost:3002
LISTINGS_BASE_URL=http://localhost:3002/listings

# Local dev: log WhatsApp replies to console instead of calling Meta API
WHATSAPP_DRY_RUN=true

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES=7d
DEFAULT_TENANT_ID=prestige-properties
PLATFORM_ADMIN_USERNAME=Admin
PLATFORM_ADMIN_EMAIL=admin@kaana.ai
PLATFORM_ADMIN_PASSWORD=Kaana@2024

KAANA_SELF_SERVE=false
KAANA_CONCIERGE_SPOTS=10

# Serve built React client from Express (production)
SERVE_CLIENT=false
