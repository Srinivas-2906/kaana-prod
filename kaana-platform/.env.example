# API (botiq-app unified server — platform + billing + WhatsApp)
VITE_API_URL=http://localhost:3002/api/platform
VITE_BILLING_URL=http://localhost:3002/api/billing
VITE_WHATSAPP_API=http://localhost:3002/api

# BotIQ inbox (unified app serves inbox UI at / when SERVE_CLIENT=true in prod;
# locally Vite dev server runs on :5174)
VITE_BOTIQ_URL=http://localhost:5174

# PropCRM + clinic desk
VITE_CRM_URL=http://localhost:5175
VITE_CLINIC_URL=http://localhost:5185

# Mini-site listings (served by botiq-app server)
VITE_LISTINGS_URL=http://localhost:3002/listings

# Platform URL (for SSO postMessage origin lock)
VITE_PLATFORM_URL=http://localhost:5180

# Production examples:
# VITE_BOTIQ_URL=https://inbox.kaana.in
# VITE_API_URL=https://api.kaana.in/api/platform
# VITE_WHATSAPP_API=https://api.kaana.in/api
# VITE_LISTINGS_URL=https://api.kaana.in/listings
# VITE_PLATFORM_URL=https://app.kaana.in

# Required for launch: real wa.me link for "Talk to us on WhatsApp" CTA
VITE_WHATSAPP_LINK=https://wa.me/91XXXXXXXXXX?text=Hi%20Kaana%2C%20I%27d%20like%20to%20learn%20about%20WhatsApp%20setup

# Optional analytics (leave blank until you have accounts)
# VITE_PLAUSIBLE_DOMAIN=kaana.in
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
