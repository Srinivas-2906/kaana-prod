# Gemini AI demo (server-side only — never expose in client code)
# Must be non-empty or POST /api/ai/generate returns 503
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Abuse protection (defaults shown; optional overrides)
GEMINI_DAILY_LIMIT=50
GEMINI_IP_WINDOW_LIMIT=3
GEMINI_IP_DAILY_LIMIT=8
GEMINI_IP_MIN_INTERVAL_MS=10000
GEMINI_MAX_PROMPT_LENGTH=400
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_CHAT_MAX_OUTPUT_TOKENS=2048

# Portfolio screenshot capture (npm run capture:portfolio)
