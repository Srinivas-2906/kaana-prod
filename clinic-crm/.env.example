# Default tenant for local dev (Denta Care demo clinic)
VITE_TENANT_SLUG=dentacare

# API base — leave unset to use Vite proxy (/api -> localhost:3002)
# VITE_WHATSAPP_API=/api

# Optional Firebase overrides (defaults to kaana-prod public config)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
