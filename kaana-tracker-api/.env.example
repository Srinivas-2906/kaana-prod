PORT=3011
NODE_ENV=development

# Local MySQL (match expense-tracker config/database.php)
DB_HOST=127.0.0.1
DB_NAME=expense_tracker
DB_USER=root
DB_PASS=

# Production Cloud Run uses DB_SOCKET instead of DB_HOST:
# DB_SOCKET=/cloudsql/kaana-prod:asia-south1:kaana-tracker-mysql

JWT_SECRET=tracker-dev-secret-change-me
JWT_EXPIRES=7d

# Google Sign-In — same Web client ID as the frontend (public)
GOOGLE_CLIENT_ID=

# Optional — email invitations.
# Preferred: Google Workspace Gmail (sends from the logged-in @kaana.in user).
#   GMAIL_SERVICE_ACCOUNT_JSON — service account JSON with domain-wide delegation
#   GMAIL_ALLOWED_DOMAINS=kaana.in
# Fallback: Resend (fixed from address; requires verified domain)
#   kaana-resend-api-key  → RESEND_API_KEY
#   kaana-resend-from     → INVITE_FROM_EMAIL
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_ALLOWED_DOMAINS=kaana.in
RESEND_API_KEY=
INVITE_FROM_EMAIL=
TOPIC_REPLY_EMAIL_ENABLED=true
TRACKER_PUBLIC_URL=http://localhost:5190

# File uploads (attachments on Q&A, work items, projects)
UPLOADS_DIR=./data/uploads
