PORT=3011
NODE_ENV=development

# Local MySQL (match expense-tracker config/database.php)
DB_HOST=127.0.0.1
DB_NAME=expense_tracker
DB_USER=root
DB_PASS=

# Production Cloud Run uses DB_SOCKET instead of DB_HOST:
# DB_SOCKET=/cloudsql/kaana-prod:asia-south1:kaana-tracker-mysql

# Legacy JWT auth (kept during Clerk migration)
JWT_SECRET=tracker-dev-secret-change-me
JWT_EXPIRES=7d

# Clerk — map from Faralin root .env:
#   CLERK_SECRET_KEY=sk_test_...          (required for Clerk auth)
#   CLERK_WEBHOOK_SECRET=whsec_...        (from Clerk Dashboard → Webhooks)
#   CLERK_PUBLISHABLE_KEY / NEXT_PUBLIC_* → frontend VITE_CLERK_PUBLISHABLE_KEY only
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Optional — email invitations (Resend). Kaana prod already has GCP secrets:
#   kaana-resend-api-key  → RESEND_API_KEY
#   kaana-resend-from     → INVITE_FROM_EMAIL  (e.g. Kaana <hello@kaana.in>)
# Get your own keys at https://resend.com → API Keys + Domains
RESEND_API_KEY=
INVITE_FROM_EMAIL=
TRACKER_PUBLIC_URL=http://localhost:5190
